        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "dfu2djyuvwcu8c" }, "expr": "sum(rate(job_submitted_total[5m]))", "legendFormat": "submitted", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "dfu2djyuvwcu8c" }, "expr": "sum(rate(job_success_total[5m]))", "legendFormat": "success", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "dfu2djyuvwcu8c" }, "expr": "sum(rate(job_failed_total[5m]))", "legendFormat": "failed", "refId": "C" }
      ],
