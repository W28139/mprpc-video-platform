      "title": "Row 1 · Job 吞吐（提交/成功/失败）",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "dfu2djyuvwcu8c" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
